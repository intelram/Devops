<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NetPilot" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/Dialog.NetPilot</item>
        <item name="android:buttonStyle">@style/Button.NetPilot</item>
    </style>
    <style name="Dialog.NetPilot" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/primary</item>
    </style>
</resources>
