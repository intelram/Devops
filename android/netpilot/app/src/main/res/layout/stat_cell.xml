<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
    android:orientation="vertical" android:focusable="true" android:importantForAccessibility="yes">
    <TextView android:id="@+id/stat_value" style="@style/Text.CardTitle" android:textSize="20sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/stat_label" style="@style/Text.Secondary" android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
