<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
    android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp"
    android:background="?android:attr/selectableItemBackground">
    <ImageView android:id="@+id/row_icon" android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginEnd="12dp" android:importantForAccessibility="no" android:visibility="gone" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/row_title" style="@style/Text.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView android:id="@+id/row_subtitle" style="@style/Text.Secondary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone" />
    </LinearLayout>
    <Button android:id="@+id/row_action" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
