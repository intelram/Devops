<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
    android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
    <ImageView android:id="@+id/app_icon" android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginEnd="12dp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/app_name" style="@style/Text.Body" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" />
    <CheckBox android:id="@+id/app_check" android:layout_width="48dp" android:layout_height="48dp"
        android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
</LinearLayout>
