<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp" android:animateLayoutChanges="true">

        <TextView style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:accessibilityHeading="true" />
        <TextView style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/home_subtitle" />

        <dev.netpilot.app.ConnectButton android:id="@+id/connect_button" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" />

        <TextView android:id="@+id/status_title" style="@style/Text.CardTitle" android:textSize="22sp"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/status_detail" style="@style/Text.Secondary" android:textSize="16sp"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:layout_marginTop="4dp" />
        <Button android:id="@+id/resume_button" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:text="@string/resume_now" android:visibility="gone" />

        <LinearLayout style="@style/Card">
            <TextView style="@style/Text.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/home_block_title" android:accessibilityHeading="true" />
            <Switch android:id="@+id/home_ads_switch" style="@style/SwitchRow" android:text="@string/list_ads" />
            <Switch android:id="@+id/home_harmful_switch" style="@style/SwitchRow" android:text="@string/list_harmful" />
            <TextView android:id="@+id/home_block_note" style="@style/Text.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:id="@+id/problems_card" style="@style/Card" android:visibility="gone">
            <TextView style="@style/Text.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/problems_title" android:accessibilityHeading="true" />
            <LinearLayout android:id="@+id/problems_container" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <include android:id="@+id/card_wifi" layout="@layout/net_card" />
            <Space android:layout_width="12dp" android:layout_height="1dp" />
            <include android:id="@+id/card_cell" layout="@layout/net_card" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/using_text" style="@style/Text.CardTitle" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
                <ImageButton android:id="@+id/using_info" android:layout_width="48dp" android:layout_height="48dp"
                    android:src="@drawable/ic_info" android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_info" />
            </LinearLayout>
            <TextView android:id="@+id/mode_chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/nav_pill" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="14sp" android:textStyle="bold"
                android:textColor="@color/primary" android:layout_marginBottom="6dp" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/using_detail" style="@style/Text.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView style="@style/Text.CardTitle" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="@string/both_title" android:accessibilityHeading="true" />
                <ImageButton android:id="@+id/both_info" android:layout_width="48dp" android:layout_height="48dp"
                    android:src="@drawable/ic_info" android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_info" />
            </LinearLayout>
            <Switch android:id="@+id/both_switch" style="@style/SwitchRow" android:text="@string/both_switch" />
            <TextView android:id="@+id/both_detail" style="@style/Text.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:id="@+id/both_bar" android:layout_width="match_parent" android:layout_height="12dp"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:visibility="gone"
                android:importantForAccessibility="no">
                <View android:id="@+id/both_bar_wifi" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="@color/primary" />
                <View android:id="@+id/both_bar_cell" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="@color/warn" />
            </LinearLayout>
            <TextView android:id="@+id/both_split" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/Text.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/st_title" android:accessibilityHeading="true" />
            <TextView android:id="@+id/st_result" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp" android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/st_run" style="@style/Button.Filled" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/st_run" />
            <Button android:id="@+id/st_history" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/st_history" />
            <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/st_note" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/Text.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/speed_title" android:accessibilityHeading="true" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <include android:id="@+id/stat_down" layout="@layout/stat_cell" />
                <include android:id="@+id/stat_up" layout="@layout/stat_cell" />
                <include android:id="@+id/stat_response" layout="@layout/stat_cell" />
            </LinearLayout>
            <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/speed_note" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView style="@style/Text.CardTitle" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="@string/blocked_title" android:accessibilityHeading="true" />
                <ImageButton android:id="@+id/blocked_info" android:layout_width="48dp" android:layout_height="48dp"
                    android:src="@drawable/ic_info" android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_info" />
            </LinearLayout>
            <TextView android:id="@+id/blocked_count" style="@style/Text.Big" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0" />
            <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/blocked_label" />
            <TextView android:id="@+id/blocked_detail" style="@style/Text.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/Text.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/usage_title" android:accessibilityHeading="true" />
            <TextView android:id="@+id/usage_today" style="@style/Text.Body" android:textStyle="bold" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/usage_mobile" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView android:id="@+id/usage_wifi" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView android:id="@+id/battery_status" style="@style/Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <TextView style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/battery_explain" />
            <Button android:id="@+id/battery_fix" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/battery_fix" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout style="@style/Card" android:layout_marginBottom="16dp">
            <TextView style="@style/Text.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/history_title" android:accessibilityHeading="true" />
            <LinearLayout android:id="@+id/history_container" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp" />
            <Button android:id="@+id/history_more" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/history_more" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
