<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Card" android:layout_width="0dp" android:layout_weight="1" android:focusable="true"
    android:importantForAccessibility="yes">
    <ImageView android:id="@+id/net_icon" android:layout_width="28dp" android:layout_height="28dp"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/net_name" style="@style/Text.CardTitle" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="6dp" />
    <TextView android:id="@+id/net_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp"
        android:paddingBottom="4dp" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
